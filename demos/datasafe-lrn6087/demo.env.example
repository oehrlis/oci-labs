# ------------------------------------------------------------------------------
# demo.env.example - LRN6087 Data Safe demo (demo.sh, reset.sh)
# Copy to demo.env (git-ignored) and fill in. No secrets here - only 1Password
# references. OCIDs come from terraform output when left empty.
# ------------------------------------------------------------------------------

# OCI CLI profile of the demo tenancy (ACE) and region
DEMO_OCI_PROFILE="ACE"
DEMO_REGION="eu-zurich-1"

# Dedicated odb_datasafe copy for the demo - NOT the everyday installation.
# demo.sh unsets ORADBA_ETC and refuses a base with its own etc/datasafe.conf,
# so no other tenancy configuration can leak onto the screen.
DEMO_ODB_BASE="${HOME}/demo/odb_datasafe-1.2.1"

# Names shown on the slides (slide 21 placeholders -> real values)
DEMO_COMP="<demo-compartment-name>"
DEMO_HOST="db01"
DEMO_PDB="AIPDB1"

# Fleet mix on the host (terraform cdb19_* / cdb26_*). The live PDB goes into
# CDB26 - SQL Firewall exists in 26ai only, a talking point next to CDB19.
DEMO_CDB19="CDB19"
DEMO_CDB19_PDBS="PDB19A,PDB19B"
DEMO_CDB26="CDB26"
DEMO_CDB26_PDBS="PDB26A,PDB26B"
DEMO_CONNECTOR="dsc-zrh-lab-dsdemo-01"
DEMO_DS_USER="DS_ADMIN"

# Data Safe secret of C##DS_ADMIN / DS_ADMIN - reference only, read at run time
DEMO_OP_DS_SECRET="op://<vault>/<datasafe-demo-ds-admin>/password"

# Registration path (register-base and step 2):
#   auto - odb when ds_target_register.sh --help lists --type, else oci (default)
#   odb  - ds_target_register.sh --type compute|onprem (odb_datasafe with --type)
#   oci  - plain OCI CLI target-database create (INSTALLED_DATABASE)
DEMO_REGISTER_MODE="auto"
# ORACLE_CLOUD (--type compute, needs the instance OCID) or ON_PREMISES (--type onprem)
DEMO_INFRA_TYPE="ORACLE_CLOUD"

# Optional overrides - empty = terraform output of envs/datasafe-demo
DEMO_COMP_OCID=""
DEMO_INSTANCE_ID=""
DEMO_DB_IP=""

# Step 5 - security assessment and user assessment OCIDs. Empty = LATEST of the
# demo PDB target (resolved at run time).
DEMO_SA=""
DEMO_UA=""

# Step 1 - synthetic fleet snapshot (sample data); "live" uses -A instead
DEMO_FLEET_SOURCE="snapshot"

# Step 6 - also restart the connector through oradba_dsctl.sh (default: status only)
DEMO_CONNECTOR_RESTART="FALSE"
