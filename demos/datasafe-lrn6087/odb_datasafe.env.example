# ------------------------------------------------------------------------------
# odb_datasafe.env.example - .env of the dedicated demo copy of odb_datasafe
# Copy to $DEMO_ODB_BASE/.env (laptop). No secrets. Placeholders only.
# ------------------------------------------------------------------------------
DS_ROOT_COMP="ocid1.compartment.oc1..xxx"
DS_CONNECTOR_COMP="ocid1.compartment.oc1..xxx"
ONPREM_CONNECTOR="dsc-zrh-lab-dsdemo-01"
OCI_CLI_PROFILE="ACE"
OCI_CLI_REGION="eu-zurich-1"
TAG_NAMESPACE="DBSec"
# Environment tag from the compartment name - open decision (runbook, Offen)
# DS_ENV_COMP_REGEX='^<prefix>-([^-]+)-.*$'
# The demo registers targets live - the file cache of the target list (odb_datasafe
# 1.3.1) is not invalidated by a registration, step 4 then missed AIPDB1 (2026-10-23)
DS_TARGET_CACHE_TTL="0"
