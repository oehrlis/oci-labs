# Author.....: Stefan Oehrli (oes) stefan.oehrli@oradba.ch
# Editor.....: Stefan Oehrli
# Date.......: 2026.10.19
# Revision...: v0.1.0
# Purpose....: One-time setup inside the Free container: create the demo PDBs
#              next to FREEPDB1. ODBSEED/ODBREPO come from the oracle-free-labs
#              PDB archives when staged, otherwise empty from PDB$SEED.
# Notes......: Generated by Ansible (role datasafe_demo) - {{ ansible_managed }}
#              Runs once, after the first database creation, from
#              /opt/oracle/scripts/setup. Uses the oracle-free-labs common
#              scripts mounted at /opt/oracle/common/scripts.
# Reference..: https://github.com/oehrlis/oci-labs
# License....: Apache License Version 2.0, January 2004 as shown
#              at http://www.apache.org/licenses/
# ------------------------------------------------------------------------------
set -euo pipefail

COMMON_DIR="/opt/oracle/common/scripts"
PDBARCH_DIR="/opt/oracle/data/pdbarch"
DEMO_PDBS=({% for p in dsdemo_pdbs[1:] %}"{{ p }}" {% endfor %})

run_sql() {
    # $1 - script, remaining args - script parameters
    local script="$1"
    shift
    printf '@%s %s\nexit\n' "${script}" "$*" | sqlplus -s -L / as sysdba
}

for pdb in "${DEMO_PDBS[@]}"; do
    archive="${PDBARCH_DIR}/pdb26ai_${pdb,,}.pdb"
    if [[ -f "${archive}" ]]; then
        echo "INFO : create ${pdb} from archive ${archive}"
        run_sql "${COMMON_DIR}/create_pdb_from_archive.sql" "${pdb}" "${archive}"
    else
        echo "INFO : no archive ${archive} - create ${pdb} empty from PDB\$SEED"
        run_sql "${COMMON_DIR}/create_pdb.sql" "${pdb}" PDBADMIN
    fi
done

echo "INFO : demo PDBs done"
