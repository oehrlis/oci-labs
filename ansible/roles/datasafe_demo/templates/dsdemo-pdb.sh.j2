#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# OraDBA - Oracle Database Infrastructure and Security, 5630 Muri, Switzerland
# ------------------------------------------------------------------------------
# Name.......: dsdemo-pdb
# Author.....: Stefan Oehrli (oes) stefan.oehrli@oradba.ch
# Editor.....: Stefan Oehrli
# Date.......: 2026.10.19
# Revision...: v0.1.0
# Purpose....: PDB and Data Safe service-account actions in the dsdemo Free
#              container - used by Ansible, demo.sh prepare and reset.sh.
# Notes......: Generated by Ansible (role datasafe_demo) - {{ ansible_managed }}
#              Runs as root (podman is rootful). The Data Safe secret is read
#              from stdin, never from an argument, and reaches the container
#              as a 0600 temp file that is removed again.
# Reference..: https://github.com/oehrlis/oci-labs
# License....: Apache License Version 2.0, January 2004 as shown
#              at http://www.apache.org/licenses/
# ------------------------------------------------------------------------------
set -euo pipefail

CONTAINER="{{ dsdemo_container_name }}"
COMMON_DIR="/opt/oracle/common/scripts"
PREREQS="/opt/oracle/local/odb_datasafe/bin/ds_database_prereqs.sh"
DS_USER="{{ dsdemo_ds_user }}"
DRY_RUN="false"

# ------------------------------------------------------------------------------
# Function: usage
# Purpose.: Print usage
# ------------------------------------------------------------------------------
usage() {
    cat << USAGE
Usage: ${0##*/} [-n|--dry-run] ACTION [ARGS]

Actions:
  list                      Show the PDBs of the container
  create PDB                Create PDB from PDB\$SEED, open READ WRITE, save state
  drop PDB                  Close and drop PDB including datafiles
  prereqs SCOPE             Create/align the Data Safe user (secret on stdin)
  check SCOPE               Verify the Data Safe user and privileges (read-only)
  drop-user SCOPE           Drop the Data Safe user (keep the profile)

SCOPE: --all | --root | --pdb PDB[,PDB...]

Options:
  -n, --dry-run             Show what would be done, change nothing
  -h, --help                Show this help

Examples:
  sudo ${0##*/} create AIPDB1
  printf '%s' "\$secret" | sudo ${0##*/} prereqs --pdb AIPDB1
  sudo ${0##*/} -n drop AIPDB1
USAGE
}

# ------------------------------------------------------------------------------
# Function: run_sql_script
# Purpose.: Run a common SQL script as SYSDBA in the container
# Args....: $1 script, $@ script parameters
# ------------------------------------------------------------------------------
run_sql_script() {
    local script="$1"
    shift
    if [[ "${DRY_RUN}" == "true" ]]; then
        echo "DRY-RUN: would run @${script} $* as SYSDBA in ${CONTAINER}"
        return 0
    fi
    printf '@%s %s\nexit\n' "${script}" "$*" \
        | podman exec -i -u oracle "${CONTAINER}" sqlplus -s -L / as sysdba
}

# ------------------------------------------------------------------------------
# Function: run_prereqs
# Purpose.: Run ds_database_prereqs.sh in the container
# Args....: $1 mode (prereqs|check|drop-user), $@ scope options
# ------------------------------------------------------------------------------
run_prereqs() {
    local mode="$1"
    shift
    local -a args=("$@" --ds-user "${DS_USER}")

    case "${mode}" in
        check) args+=(--check) ;;
        drop-user) args+=(--drop-user) ;;
        prereqs) ;;
        *) echo "ERROR: unknown mode ${mode}" >&2; return 1 ;;
    esac
    [[ "${DRY_RUN}" == "true" ]] && args+=(--dry-run)

    if [[ "${mode}" != "prereqs" ]]; then
        podman exec -u oracle "${CONTAINER}" bash "${PREREQS}" "${args[@]}"
        return
    fi

    # Secret from stdin -> base64 temp file inside the container (0600)
    local secret
    secret="$(cat)"
    [[ -n "${secret}" ]] || { echo "ERROR: Data Safe secret expected on stdin" >&2; return 1; }
    printf '%s' "${secret}" | podman exec -i -u oracle "${CONTAINER}" bash -c '
        set -euo pipefail
        umask 077
        f="$(mktemp)"
        trap "rm -f \"$f\"" EXIT
        base64 -w0 > "$f"
        bash "$0" "$@" --secret-file "$f"
    ' "${PREREQS}" "${args[@]}"
}

# - Main -----------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        -n | --dry-run) DRY_RUN="true"; shift ;;
        -h | --help) usage; exit 0 ;;
        *) break ;;
    esac
done

[[ $# -ge 1 ]] || { usage; exit 1; }
action="$1"
shift

case "${action}" in
    list)
        printf 'show pdbs\nexit\n' | podman exec -i -u oracle "${CONTAINER}" sqlplus -s -L / as sysdba
        ;;
    create)
        [[ $# -eq 1 ]] || { echo "ERROR: create needs a PDB name" >&2; exit 1; }
        run_sql_script "${COMMON_DIR}/create_pdb.sql" "${1^^}" PDBADMIN
        ;;
    drop)
        [[ $# -eq 1 ]] || { echo "ERROR: drop needs a PDB name" >&2; exit 1; }
        run_sql_script "${COMMON_DIR}/drop_pdb.sql" "${1^^}"
        ;;
    prereqs | check | drop-user)
        [[ $# -ge 1 ]] || { echo "ERROR: ${action} needs a scope (--all, --root, --pdb PDB)" >&2; exit 1; }
        run_prereqs "${action}" "$@"
        ;;
    *)
        echo "ERROR: unknown action ${action}" >&2
        usage
        exit 1
        ;;
esac
# - EOF ------------------------------------------------------------------------
