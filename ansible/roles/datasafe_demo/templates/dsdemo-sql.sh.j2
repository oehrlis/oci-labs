# Purpose....: Run SQL from stdin as SYSDBA in the dsdemo Free container.
# Notes......: Generated by Ansible (role datasafe_demo) - {{ ansible_managed }}
#              Usage: echo 'show pdbs' | sudo dsdemo-sql
# Reference..: https://github.com/oehrlis/oci-labs
# License....: Apache License Version 2.0, January 2004 as shown
#              at http://www.apache.org/licenses/
# ------------------------------------------------------------------------------
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    echo "Usage: echo '<sql>' | ${0##*/}   (runs as SYSDBA in container {{ dsdemo_container_name }})"
    exit 0
fi

exec podman exec -i -u oracle "{{ dsdemo_container_name }}" sqlplus -s -L / as sysdba
