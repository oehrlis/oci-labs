# {{ ansible_managed }}
# odb_datasafe configuration for the LRN6087 demo host. No secrets.
# Loaded from $ODB_DATASAFE_BASE/.env by every odb_datasafe script.
DS_ROOT_COMP="{{ dsdemo_compartment_ocid }}"
DS_CONNECTOR_COMP="{{ dsdemo_compartment_ocid }}"
ONPREM_CONNECTOR="{{ dsdemo_connector_name }}"
OCI_CLI_PROFILE="DEFAULT"
OCI_CLI_REGION="{{ dsdemo_region }}"
{% if dsdemo_env_comp_regex | length > 0 %}
DS_ENV_COMP_REGEX='{{ dsdemo_env_comp_regex }}'
{% else %}
# DS_ENV_COMP_REGEX='^<prefix>-([^-]+)-.*$' - open decision, see docs/datasafe-demo.md
{% endif %}
