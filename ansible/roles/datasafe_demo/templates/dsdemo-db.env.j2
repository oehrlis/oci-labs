# {{ ansible_managed }}
# Environment of the dsdemo-db container (Oracle AI Database 26ai Free).
# Root only (0600) - holds ORACLE_PWD.
TZ={{ dsdemo_timezone }}
ORACLE_PWD={{ dsdemo_sys_password }}
ORACLE_SID={{ oracle_sid }}
ORACLE_PDB={{ dsdemo_pdbs[0] }}
{% if dsdemo_build_image | bool %}
TNS_ADMIN=/opt/oracle/network/admin
{% endif %}
