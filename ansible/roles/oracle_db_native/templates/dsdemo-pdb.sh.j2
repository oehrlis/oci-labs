#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# OraDBA - Oracle Database Infrastructure and Security, 5630 Muri, Switzerland
# ------------------------------------------------------------------------------
# Name.......: dsdemo-pdb
# Author.....: Stefan Oehrli (oes) stefan.oehrli@oradba.ch
# Editor.....: Stefan Oehrli
# Date.......: 2026.10.20
# Revision...: v0.2.0
# Purpose....: PDB and Data Safe service-account actions in the CDBs of the
#              demo host - used by Ansible, demo.sh and reset.sh.
# Notes......: Generated by Ansible (role oracle_db_native) - {{ ansible_managed }}
#              Runs as root, executes as {{ oracle_os_user }}. The Data Safe
#              secret is read from stdin, never from an argument, and reaches
#              ds_database_prereqs.sh as a 0600 base64 file that is removed
#              again. The start PDBs are protected against drop.
# Reference..: https://github.com/oehrlis/oci-labs
# License....: Apache License Version 2.0, January 2004 as shown
#              at http://www.apache.org/licenses/
# ------------------------------------------------------------------------------
set -euo pipefail

ORA_USER="{{ oracle_os_user }}"
ORA_GROUP="{{ oracle_os_group_install }}"
ORA_BASE="{{ oracle_base }}"
PREREQS="{{ oradb_odb_datasafe_base }}/bin/ds_database_prereqs.sh"
DS_USER="{{ oradb_ds_user }}"
SID="{{ oradb_live_cdb }}"
PROTECTED_PDBS=" PDB\$SEED{% for db in oradb_databases %}{% for p in db.pdbs %} {{ p | upper }}{% endfor %}{% endfor %} "
DRY_RUN="false"
SECRET_FILE=""

# ------------------------------------------------------------------------------
# Function: usage
# Purpose.: Print usage
# ------------------------------------------------------------------------------
usage() {
    cat << USAGE
Usage: ${0##*/} [-d|--db SID] [-n|--dry-run] ACTION [ARGS]

Actions:
  list                      Show the PDBs of the CDB
  create PDB                Create PDB from PDB\$SEED, open READ WRITE, save state
  drop PDB                  Close and drop PDB including datafiles (not a start PDB)
  prereqs SCOPE             Create/align the Data Safe user (secret on stdin)
  check SCOPE               Verify the Data Safe user and privileges (read-only)
  drop-user SCOPE           Drop the Data Safe user (keep the profile)

SCOPE: --all | --root | --pdb PDB[,PDB...]

Options:
  -d, --db SID              CDB from /etc/oratab (default: ${SID})
  -n, --dry-run             Show what would be done, change nothing
  -h, --help                Show this help

Examples:
  sudo ${0##*/} create AIPDB1
  printf '%s' "\$secret" | sudo ${0##*/} prereqs --pdb AIPDB1
  sudo ${0##*/} --db {{ oradb_cdb19_name }} check --all
  sudo ${0##*/} -n drop AIPDB1
USAGE
}

# ------------------------------------------------------------------------------
# Function: cleanup
# Purpose.: Remove the temporary secret file
# ------------------------------------------------------------------------------
cleanup() {
    [[ -n "${SECRET_FILE}" ]] && rm -f "${SECRET_FILE}"
    return 0
}
trap cleanup EXIT INT TERM

# ------------------------------------------------------------------------------
# Function: ora_home
# Purpose.: ORACLE_HOME of ${SID} from /etc/oratab
# Output..: path on stdout
# ------------------------------------------------------------------------------
ora_home() {
    local home
    home="$(awk -F: -v s="${SID}" '$1 == s {print $2}' /etc/oratab)"
    [[ -n "${home}" ]] || { echo "ERROR: ${SID} not in /etc/oratab" >&2; return 1; }
    printf '%s' "${home}"
}

# ------------------------------------------------------------------------------
# Function: as_oracle
# Purpose.: Run a command as the Oracle software owner with the CDB environment
# Args....: $@ command
# ------------------------------------------------------------------------------
as_oracle() {
    local home
    home="$(ora_home)"
    runuser -u "${ORA_USER}" -- env ORACLE_SID="${SID}" ORACLE_HOME="${home}" ORACLE_BASE="${ORA_BASE}" \
        TNS_ADMIN="${home}/network/admin" PATH="${home}/bin:/usr/local/bin:/usr/bin:/bin" \
        LANG=en_US.UTF-8 "$@"
}

# ------------------------------------------------------------------------------
# Function: run_sql
# Purpose.: Run SQL from stdin as SYSDBA, exit non-zero on the first error
# ------------------------------------------------------------------------------
run_sql() {
    { echo "whenever sqlerror exit failure"; cat; echo "exit"; } | as_oracle sqlplus -s -L / as sysdba
}

# ------------------------------------------------------------------------------
# Function: pdb_exists
# Purpose.: Check whether a PDB exists in the CDB
# Args....: $1 PDB name (upper case)
# Returns.: 0 when it exists
# ------------------------------------------------------------------------------
pdb_exists() {
    local n
    n="$(printf "set heading off feedback off pagesize 0\nselect count(*) from v\$pdbs where name = '%s';\n" "$1" \
        | run_sql | tr -d '[:space:]')"
    [[ "${n}" == "1" ]]
}

# ------------------------------------------------------------------------------
# Function: create_pdb
# Purpose.: Create a PDB from PDB$SEED (OMF), open it and save its state
# Args....: $1 PDB name
# Notes...: The PDB admin gets a random password nobody needs - Data Safe uses
#           DS_ADMIN, created afterwards by prereqs.
# ------------------------------------------------------------------------------
create_pdb() {
    local pdb="${1^^}"
    [[ "${pdb}" =~ ^[A-Z][A-Z0-9_]{0,29}$ ]] || { echo "ERROR: invalid PDB name ${pdb}" >&2; return 1; }
    if pdb_exists "${pdb}"; then
        echo "INFO : ${pdb} already exists in ${SID} - nothing to do"
        return 0
    fi
    if [[ "${DRY_RUN}" == "true" ]]; then
        echo "DRY-RUN: would create ${pdb} in ${SID}, open it and save its state"
        return 0
    fi
    run_sql << SQL
create pluggable database ${pdb} admin user pdbadmin identified by "Pdb$(openssl rand -hex 12)";
alter pluggable database ${pdb} open;
alter pluggable database ${pdb} save state;
SQL
    echo "INFO : ${pdb} created in ${SID}"
}

# ------------------------------------------------------------------------------
# Function: drop_pdb
# Purpose.: Close and drop a PDB including datafiles
# Args....: $1 PDB name
# ------------------------------------------------------------------------------
drop_pdb() {
    local pdb="${1^^}"
    [[ "${PROTECTED_PDBS}" != *" ${pdb} "* ]] || { echo "ERROR: ${pdb} is a start PDB - refusing to drop" >&2; return 1; }
    if ! pdb_exists "${pdb}"; then
        echo "INFO : ${pdb} does not exist in ${SID} - nothing to do"
        return 0
    fi
    if [[ "${DRY_RUN}" == "true" ]]; then
        echo "DRY-RUN: would close and drop ${pdb} in ${SID} including datafiles"
        return 0
    fi
    run_sql << SQL
alter pluggable database ${pdb} close immediate;
drop pluggable database ${pdb} including datafiles;
SQL
    echo "INFO : ${pdb} dropped from ${SID}"
}

# ------------------------------------------------------------------------------
# Function: run_prereqs
# Purpose.: Run ds_database_prereqs.sh for the CDB
# Args....: $1 mode (prereqs|check|drop-user), $@ scope options
# ------------------------------------------------------------------------------
run_prereqs() {
    local mode="$1"
    shift
    local -a args=("$@" --ds-user "${DS_USER}")

    case "${mode}" in
        check) args+=(--check) ;;
        drop-user) args+=(--drop-user) ;;
        prereqs) ;;
        *) echo "ERROR: unknown mode ${mode}" >&2; return 1 ;;
    esac
    [[ "${DRY_RUN}" == "true" ]] && args+=(--dry-run)

    if [[ "${mode}" == "prereqs" ]]; then
        local secret
        secret="$(cat)"
        [[ -n "${secret}" ]] || { echo "ERROR: Data Safe secret expected on stdin" >&2; return 1; }
        SECRET_FILE="$(umask 077 && mktemp)"
        printf '%s' "${secret}" | base64 -w0 > "${SECRET_FILE}"
        chown "${ORA_USER}:${ORA_GROUP}" "${SECRET_FILE}"
        args+=(--secret-file "${SECRET_FILE}")
    fi
    as_oracle bash "${PREREQS}" "${args[@]}"
}

# - Main -----------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        -d | --db) SID="${2:?--db needs a SID}"; shift 2 ;;
        -n | --dry-run) DRY_RUN="true"; shift ;;
        -h | --help) usage; exit 0 ;;
        *) break ;;
    esac
done

[[ $# -ge 1 ]] || { usage; exit 1; }
action="$1"
shift

case "${action}" in
    list)
        printf 'show pdbs\n' | run_sql
        ;;
    create)
        [[ $# -eq 1 ]] || { echo "ERROR: create needs a PDB name" >&2; exit 1; }
        create_pdb "$1"
        ;;
    drop)
        [[ $# -eq 1 ]] || { echo "ERROR: drop needs a PDB name" >&2; exit 1; }
        drop_pdb "$1"
        ;;
    prereqs | check | drop-user)
        [[ $# -ge 1 ]] || { echo "ERROR: ${action} needs a scope (--all, --root, --pdb PDB)" >&2; exit 1; }
        run_prereqs "${action}" "$@"
        ;;
    *)
        echo "ERROR: unknown action ${action}" >&2
        usage
        exit 1
        ;;
esac
# - EOF ------------------------------------------------------------------------
