#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# OraDBA - Oracle Database Infrastructure and Security, 5630 Muri, Switzerland
# ------------------------------------------------------------------------------
# Name.......: dsdemo-sql
# Author.....: Stefan Oehrli (oes) stefan.oehrli@oradba.ch
# Editor.....: Stefan Oehrli
# Date.......: 2026.10.20
# Revision...: v0.2.0
# Purpose....: Run SQL from stdin as SYSDBA in one CDB of the demo host.
# Notes......: Generated by Ansible (role oracle_db_native) - {{ ansible_managed }}
#              Runs as root, switches to {{ oracle_os_user }}. ORACLE_HOME
#              comes from /etc/oratab.
#              Usage: echo 'show pdbs' | sudo dsdemo-sql [SID]
# Reference..: https://github.com/oehrlis/oci-labs
# License....: Apache License Version 2.0, January 2004 as shown
#              at http://www.apache.org/licenses/
# ------------------------------------------------------------------------------
set -euo pipefail

DEFAULT_SID="{{ oradb_live_cdb }}"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    echo "Usage: echo '<sql>' | ${0##*/} [SID]   (SYSDBA, default SID ${DEFAULT_SID})"
    exit 0
fi

sid="${1:-${DEFAULT_SID}}"
home="$(awk -F: -v s="${sid}" '$1 == s {print $2}' /etc/oratab)"
[[ -n "${home}" && -x "${home}/bin/sqlplus" ]] || { echo "ERROR: ${sid} not in /etc/oratab or no sqlplus" >&2; exit 1; }

exec runuser -u "{{ oracle_os_user }}" -- env ORACLE_SID="${sid}" ORACLE_HOME="${home}" \
    ORACLE_BASE="{{ oracle_base }}" TNS_ADMIN="${home}/network/admin" \
    "${home}/bin/sqlplus" -s -L / as sysdba
# - EOF ------------------------------------------------------------------------
