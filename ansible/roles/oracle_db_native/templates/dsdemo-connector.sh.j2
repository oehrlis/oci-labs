#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# OraDBA - Oracle Database Infrastructure and Security, 5630 Muri, Switzerland
# ------------------------------------------------------------------------------
# Name.......: dsdemo-connector
# Author.....: Stefan Oehrli (oes) stefan.oehrli@oradba.ch
# Editor.....: Stefan Oehrli
# Date.......: 2026.10.20
# Revision...: v0.2.0
# Purpose....: Data Safe connector managed with OraDBA - thin wrapper around
#              oradba_dsctl.sh for demo.sh step 6.
# Notes......: Generated by Ansible (role oracle_db_native) - {{ ansible_managed }}
#              Runs as root, executes oradba_dsctl.sh as {{ oracle_os_user }}
#              in a login shell (OraDBA environment from .bash_profile). The
#              connector is addressed by its OraDBA home {{ oradb_connector_oradba_home }}.
# Reference..: https://github.com/oehrlis/oci-labs
# License....: Apache License Version 2.0, January 2004 as shown
#              at http://www.apache.org/licenses/
# ------------------------------------------------------------------------------
set -euo pipefail

ORADBA_BASE="{{ oradb_oradba_dir }}"
DSCTL="${ORADBA_BASE}/bin/oradba_dsctl.sh"
CONNECTOR_HOME="{{ oradb_connector_oradba_home }}"

case "${1:-}" in
    status | start | stop | restart)
        action="$1"
        ;;
    services)
        exec runuser -l "{{ oracle_os_user }}" -c "ORADBA_BASE='${ORADBA_BASE}' '${DSCTL}' services"
        ;;
    -h | --help | "")
        echo "Usage: ${0##*/} {status|start|stop|restart|services}   (oradba_dsctl.sh, home ${CONNECTOR_HOME})"
        exit 0
        ;;
    *)
        echo "ERROR: unknown action $1" >&2
        exit 1
        ;;
esac

[[ -x "${DSCTL}" ]] || { echo "ERROR: ${DSCTL} not found - is OraDBA installed?" >&2; exit 1; }
exec runuser -l "{{ oracle_os_user }}" -c "ORADBA_BASE='${ORADBA_BASE}' '${DSCTL}' ${action} '${CONNECTOR_HOME}'"
