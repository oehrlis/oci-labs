#!/usr/bin/expect -f
#-------------------------------------------------------------------------------
# OraDBA - Oracle Database Infrastructure and Security, 5630 Muri, Switzerland
#-------------------------------------------------------------------------------
# Managed by Ansible role db19_engineering - do not edit by hand.
# Purpose: Drive the interactive AutoUpgrade -load_password prompt to create the
#          keystore and store My Oracle Support credentials in it.
# Notes..: Oracle exposes no flag, environment variable, or file mechanism for
#          MOS credentials - the interactive prompt is the only documented
#          interface. Piping stdin does not work either: the command loop needs
#          a real TTY and hits EOF immediately, so expect is required.
#
#          Verified prompt sequence (AutoUpgrade 26.5):
#            Enter password:                    keystore password
#            Enter password again:              keystore password again
#            MOS>                               add -user <email>
#            Enter your secret/Password:        MOS password
#            Re-enter your secret/Password:     MOS password again
#            MOS>                               save / exit
#            Save ... before exiting [YES|NO]?  YES
#
#          Written with mode 0700 and removed immediately after use.
#          Auto-login mode creates cwallet.sso, after which every later
#          AutoUpgrade run is fully non-interactive.
#-------------------------------------------------------------------------------

set timeout 180
log_user 0

spawn {{ db19_java_bin }} -jar {{ db19_autoupgrade_jar }} -config {{ db19_autoupgrade_config_dir }}/download-{{ db19_home_ru }}.cfg -patch -load_password

# --- keystore creation (skipped when the keystore already exists) -------------
expect {
    "Enter password:" {
        send "{{ db19_autoupgrade_keystore_password }}\r"
        expect "Enter password again:"
        send "{{ db19_autoupgrade_keystore_password }}\r"
    }
    -re {MOS>} {
        # keystore already present - nothing to create
    }
    timeout { puts "TIMEOUT waiting for the keystore password prompt"; exit 2 }
}

# --- store the MOS credential -------------------------------------------------
expect {
    -re {MOS>} { send "add -user {{ mos_username }}\r" }
    timeout { puts "TIMEOUT waiting for the MOS prompt"; exit 3 }
}

expect {
    "Enter your secret/Password:" { send "{{ mos_password }}\r" }
    timeout { puts "TIMEOUT waiting for the secret prompt"; exit 4 }
}

expect {
    "Re-enter your secret/Password:" { send "{{ mos_password }}\r" }
    timeout { puts "TIMEOUT waiting for the secret confirmation prompt"; exit 5 }
}

# --- optional CSI ---------------------------------------------------------------
# The Oracle Update Advisor (gold image service) needs a Customer Support
# Identifier in addition to the MOS SSO credential. Without it, a gold image
# request fails with "Failed to process the gold_image parameter".
{% if mos_csi | default('') | length > 0 %}
expect {
    -re {MOS>} { send "add -csi {{ mos_csi }}\r" }
    timeout { puts "TIMEOUT waiting for the prompt before add -csi"; exit 10 }
}
{% endif %}

# --- save, enabling auto-login so later runs need no password ------------------
expect {
    -re {PKI-[0-9]+} { puts "KEYSTORE ERROR - see the AutoUpgrade output"; exit 6 }
    -re {MOS>} { send "save\r" }
    timeout { puts "TIMEOUT waiting for the prompt after add -user"; exit 7 }
}

expect {
    -re {(?i)auto-login} { send "YES\r"; exp_continue }
    -re {MOS>} { send "exit\r" }
    timeout { puts "TIMEOUT waiting for the prompt after save"; exit 8 }
}

expect {
    -re {(?i)before exiting} { send "YES\r" }
    eof { exit 0 }
    timeout { puts "TIMEOUT waiting for the exit confirmation"; exit 9 }
}

expect eof
exit 0
