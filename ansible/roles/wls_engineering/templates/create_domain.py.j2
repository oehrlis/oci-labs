# WLST offline: AdminServer + {{ wls_managed_server }}, production mode, SSL and a
# domain-wide administration port on every version (14.1.2+ requires it in
# secured production mode, older versions get the same client handling).
# The admin password comes from the environment (WLS_ADMIN_PW), never argv.
# ------------------------------------------------------------------------------
import os

readTemplate('{{ wv_home }}/wlserver/common/templates/wls/wls.jar')

cd('/')
cmo.setName('wls{{ wv_tag }}')

cd('/Security/base_domain/User/weblogic')
cmo.setName('{{ wls_admin_user }}')
cmo.setPassword(os.environ['WLS_ADMIN_PW'])

cd('/')
set('AdministrationPortEnabled', 'true')
set('AdministrationPort', {{ wv_ports.admin_port }})

cd('/Servers/AdminServer')
set('ListenAddress', '')
set('ListenPort', {{ wv_ports.admin_listen }})
try:
    cd('/Servers/AdminServer/SSL/AdminServer')
except:
    cd('/Servers/AdminServer')
    create('AdminServer', 'SSL')
    cd('SSL/AdminServer')
set('Enabled', 'true')
set('ListenPort', {{ wv_ports.admin_ssl }})

cd('/')
create('{{ wls_managed_server }}', 'Server')
cd('/Servers/{{ wls_managed_server }}')
set('ListenAddress', '')
set('ListenPort', {{ wv_ports.ms_listen }})
# Two servers on one host: the managed server needs its own admin port.
set('AdministrationPort', {{ wv_ports.ms_admin }})
create('{{ wls_managed_server }}', 'SSL')
cd('SSL/{{ wls_managed_server }}')
set('Enabled', 'true')
set('ListenPort', {{ wv_ports.ms_ssl }})

# The REST management API carries the smoke test, the deployment and the stop.
cd('/')
try:
    create('wls{{ wv_tag }}', 'RestfulManagementServices')
except:
    pass
try:
    cd('/RestfulManagementServices/wls{{ wv_tag }}')
    set('Enabled', 'true')
except:
    pass

setOption('ServerStartMode', 'prod')
setOption('JavaHome', '{{ wv_jdk }}')
setOption('OverwriteDomain', 'false')
writeDomain('{{ wv_domain }}')
closeTemplate()
exit()
