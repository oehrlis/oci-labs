# .env.example - cpu-patch-test stack
# Copy to .env and fill in your values. .env is git-ignored - never commit it.
# Source before terraform commands: source .env

# ---------------------------------------------------------------------------
# Provider / tenancy
# ---------------------------------------------------------------------------
# Profile in ~/.oci/config pointing at the lab tenancy.
export TF_VAR_oci_config_profile="TRIVADIS"

# Base compartment for the whole stack. Terraform never creates or deletes a
# compartment - it only deploys into this existing one, so destroy leaves
# nothing behind.
# Alternative to the OCID: set TF_VAR_compartment_name plus TF_VAR_tenancy_ocid
# and Terraform looks the compartment up by name.
#   export TF_VAR_compartment_name="cpureport"
#   export TF_VAR_tenancy_ocid="ocid1.tenancy.oc1..xxx"
export TF_VAR_compartment_ocid="ocid1.compartment.oc1..xxx"

export TF_VAR_region_key="chzh"
export TF_VAR_environment_code="l"

# ---------------------------------------------------------------------------
# Lab sizing
# ---------------------------------------------------------------------------
# 1 for a CPU patch test, N for a workshop.
export TF_VAR_lab_count=1

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# Restrict SSH to your own address - the default is no external SSH at all.
export TF_VAR_allowed_ssh_cidrs='["203.0.113.10/32"]'

# SSH public key for the opc user.
# Preferred - 1Password (single line, no backslash continuation):
# export TF_VAR_ssh_public_key=$(op read "op://oradba-labs/cpu-lab-ssh/public key")
#
# Fallback - read the key generated in this directory:
export TF_VAR_ssh_public_key=$(cat .ssh/cpu-lab.pub)

# ---------------------------------------------------------------------------
# Oracle DB / patch level
# ---------------------------------------------------------------------------
export TF_VAR_oracle_sid="CPUDB"

# Base RU the DB is installed with, and the CPU target RU to patch to.
# Update db_target_ru every quarter (2026-07 CPU => 19.32).
export TF_VAR_db_base_ru="19.31"
export TF_VAR_db_target_ru="19.32"

# ORACLE_HOME paths are derived from db_oracle_base + RU when left unset:
#   /u01/app/oracle/product/19.31/dbhome_1
#   /u01/app/oracle/product/19.32/dbhome_1
# export TF_VAR_db_oracle_base="/u01/app/oracle"
# export TF_VAR_db_oracle_home_base="/u01/app/oracle/product/19.31/dbhome_1"
# export TF_VAR_db_oracle_home_target="/u01/app/oracle/product/19.32/dbhome_1"

# ---------------------------------------------------------------------------
# Database SYS password
# ---------------------------------------------------------------------------
# Not set here: Terraform generates it. Hand it to Ansible with
#   -e db19_sys_password="$(terraform output -raw db_sys_password)"

# ---------------------------------------------------------------------------
# Oracle 19c base image
# ---------------------------------------------------------------------------
# AutoUpgrade downloads every patch, but NOT the 19c base image, and the Oracle
# Updater service has no gold image for RU 19.31/19.32 (verified 2026-08-19 with
# AutoUpgrade 26.5). LINUX.X64_193000_db_home.zip must therefore be staged.
# It already exists in this tenancy: bucket "orarepo", namespace trivadisbdsxsp,
# 3'059'705'302 bytes. Create a pre-authenticated request for the bucket and put
# its URL here - it must end with "/o/":
#   oci --profile TRIVADIS os preauth-request create --bucket-name orarepo \
#     --name cpu-lab-base-image --access-type AnyObjectRead \
#     --time-expires 2026-12-31T23:59:59Z
# export TF_VAR_db_base_image_url="https://objectstorage.eu-zurich-1.oraclecloud.com/p/<token>/n/trivadisbdsxsp/b/orarepo/o/"
