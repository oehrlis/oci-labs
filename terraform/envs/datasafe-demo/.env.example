# .env.example - datasafe-demo stack (LRN6087)
# Copy to .env and fill in your values. .env is git-ignored - never commit it.
# Source before terraform commands: set -a; . ./.env; set +a

# ---------------------------------------------------------------------------
# Provider / tenancy
# ---------------------------------------------------------------------------
export TF_VAR_oci_config_profile="ACE"
export TF_VAR_region="eu-zurich-1"

# Existing compartment - Terraform never creates or deletes it.
export TF_VAR_compartment_ocid="ocid1.compartment.oc1..xxx"
#   export TF_VAR_compartment_name="<compartment_name>"
#   export TF_VAR_tenancy_ocid="ocid1.tenancy.oc1..xxx"

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# Optional extra SSH key from 1Password (single line, no backslash):
# export TF_VAR_ssh_public_key=$(op read "op://<vault>/<item>/public key")

# ---------------------------------------------------------------------------
# Data Safe service account secret (DS_ADMIN / C##DS_ADMIN)
# ---------------------------------------------------------------------------
# Not a Terraform variable. Ansible and demo.sh read it from 1Password at run
# time. Keep only the reference here, never the value:
export DSDEMO_OP_DS_SECRET="op://<vault>/<datasafe-demo-ds-admin>/password"
